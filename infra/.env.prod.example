# ─── 운영 환경 변수 (infra/.env.prod) ────────────────────────────────────────
# 이 파일을 복사하여 infra/.env.prod 를 생성하고 실제 값으로 채우세요.
# .env.prod 는 .gitignore에 포함되어 있습니다 (절대 커밋하지 마세요).

# ─── GitHub Container Registry (GHCR) ─────────────
GHCR_USERNAME=YOUR_GITHUB_USERNAME
GHCR_REPO=YOUR_GITHUB_REPO_NAME

# 배포할 이미지 태그. 기본값 latest(가장 최근 빌드).
# 특정 릴리즈로 고정하거나 롤백하려면 "v1.0.3" 처럼 VERSION 파일 값에 맞춰 지정.
TAG=latest


# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=ams_db
POSTGRES_USER=ams
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ─── Backend ─────────────────────────────────────────────────────────────────
# PostgreSQL 연결 URL (db 서비스 컨테이너 이름 사용)
DATABASE_URL=postgresql+asyncpg://ams:CHANGE_THIS_STRONG_PASSWORD@db:5432/ams_db

# JWT 시크릿 키 (운영: 최소 64자 이상 랜덤 문자열)
SECRET_KEY=9f2c8e4b1a3d6f7890c2d4e5b678a1230ef456789abcdef012345678901234ab

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# 프론트엔드 CORS 허용 URL (NAS IP 또는 도메인)
FRONTEND_URL=http://192.168.0.22

# ─── Dell TechDirect Warranty API ───────────────────────────────────────────
# 비워 두면 Dell 워런티 조회는 '확장 프로그램 대기'로 쌓이고, Dell 조회 확장 프로그램이 처리한다
# (tools/dell-warranty-extension). 키를 넣으면 백엔드가 바로 조회한다.
DELL_API_CLIENT_ID=
DELL_API_CLIENT_SECRET=

# ─── HPE 워런티 자동 조회 (warranty-worker 컨테이너) ─────────────────────────
# 조회 전용 HPE 계정 (추가 인증/MFA 가 꺼진 계정이어야 자동 로그인 가능)
HPE_USERNAME=
HPE_PASSWORD=
# 로그인 세션 보관 폴더 (NAS)
WARRANTY_DATA_PATH=/volume1/docker/portainer/ams/warranty

# ─── 승인 요청 Discord 알림 ──────────────────────────────────────────────────
# 비워 두면 알림이 꺼진다. 둘 중 하나(또는 둘 다)를 설정한다.
# ※ 웹후크 URL·봇 토큰은 비밀번호와 같다. 이 저장소는 공개(public)이므로
#   실제 값은 절대 커밋하지 말고 Portainer 스택 환경변수로만 넣는다.
# 알림 메시지의 '승인 관리' 링크에 쓰일 AMS 주소
APP_PUBLIC_URL=http://ezenuri.synology.me:8070
# (1) 채널 웹후크 — 디스코드 채널 설정 > 연동 > 웹후크 에서 발급
DISCORD_WEBHOOK_URL=
# (2) 봇 — DM 채널로 보내려면 이 방식이 필요하다 (웹후크는 DM 불가)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
